{
  "name": "nse_system",
  "version": "1.0.0",
  "private": true,
  "description": "NSE Research terminal - frontend tooling (Tailwind v4 build + vendored ESM utilities)",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i terminal/static/tailwind.src.css -o terminal/static/tailwind.css --minify",
    "watch:css": "tailwindcss -i terminal/static/tailwind.src.css -o terminal/static/tailwind.css --watch=always"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-static": "^1.52.0",
    "tailwind-merge": "^3.7.0"
  }
}
